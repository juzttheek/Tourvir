---
import PageShell from '../layouts/PageShell.astro';
---

<PageShell
  title="Gallery — Tourvir | Sri Lanka in Pictures"
  description="Explore the breathtaking beauty of Sri Lanka through our curated photo gallery — beaches, temples, wildlife, mountains, and cultural heritage."
  pageStyles={["css/pages/gallery.css?v=4"]}
  activeRoute="gallery.html"
>
<main class="main-content">

      <!-- Page Hero -->
      <section class="page-hero">
        <div class="page-hero__bg">
          <img src="images/hero/gallery_hero_bg.webp" alt="Sri Lanka Beach">
        </div>
        <div class="page-hero__overlay"></div>
        <div class="page-hero__content">
          <h1 class="page-hero__title">Photo Gallery</h1>
          <p class="page-hero__subtitle">Discover the breathtaking beauty of Sri Lanka through our curated collection</p>
          <div class="page-hero__breadcrumb">
            <a href="index.html">Home</a>
            <span>→</span>
            <span>Gallery</span>
          </div>
        </div>
      </section>

      <!-- Gallery Stats -->
      <section class="section">
        <div class="container">
          <div class="gallery-stats reveal">
            <div class="gallery-stat">
              <div class="gallery-stat__number">50+</div>
              <div class="gallery-stat__label">Destinations Captured</div>
            </div>
            <div class="gallery-stat">
              <div class="gallery-stat__number">200+</div>
              <div class="gallery-stat__label">Professional Photos</div>
            </div>
            <div class="gallery-stat">
              <div class="gallery-stat__number">8</div>
              <div class="gallery-stat__label">UNESCO Sites</div>
            </div>
          </div>

          <!-- Filter Pills -->
          <div class="filter-pills reveal">
            <button class="filter-pill active" data-filter="all">All</button>
            <button class="filter-pill" data-filter="beaches">Beaches</button>
            <button class="filter-pill" data-filter="temples">Temples</button>
            <button class="filter-pill" data-filter="wildlife">Wildlife</button>
            <button class="filter-pill" data-filter="mountains">Mountains</button>
            <button class="filter-pill" data-filter="culture">Culture</button>
            <button class="filter-pill" data-filter="heritage">Heritage</button>
          </div>

          <!-- Gallery Grid -->
          <div class="gallery-grid gallery-grid--masonry" id="gallery-dynamic-container">
            <article class="gallery-item gallery-item--tall" data-category="heritage" tabindex="0">
              <img src="images/gallery/sigiriya.webp" alt="Sigiriya rock fortress rising above the forest" loading="eager">
              <div class="gallery-item__overlay"><div class="gallery-item__zoom" aria-hidden="true">↗</div><h4 class="gallery-item__title">Sigiriya Rock Fortress</h4><p class="gallery-item__location">Central Province</p></div>
            </article>
            <article class="gallery-item" data-category="wildlife" tabindex="0">
              <img src="images/gallery/elephant.webp" alt="Sri Lankan elephant in its natural habitat" loading="lazy">
              <div class="gallery-item__overlay"><div class="gallery-item__zoom" aria-hidden="true">↗</div><h4 class="gallery-item__title">Wild Encounters</h4><p class="gallery-item__location">Sri Lanka</p></div>
            </article>
            <article class="gallery-item gallery-item--wide" data-category="mountains" tabindex="0">
              <img src="images/gallery/tea_plantation.webp" alt="Green tea plantations across the Sri Lankan hill country" loading="lazy">
              <div class="gallery-item__overlay"><div class="gallery-item__zoom" aria-hidden="true">↗</div><h4 class="gallery-item__title">Hill Country Tea</h4><p class="gallery-item__location">Central Highlands</p></div>
            </article>
            <article class="gallery-item" data-category="culture" tabindex="0">
              <img src="images/gallery/train.webp" alt="Scenic train travelling through Sri Lanka's hill country" loading="lazy">
              <div class="gallery-item__overlay"><div class="gallery-item__zoom" aria-hidden="true">↗</div><h4 class="gallery-item__title">Scenic Rail Journey</h4><p class="gallery-item__location">Hill Country</p></div>
            </article>
            <article class="gallery-item" data-category="temples" tabindex="0">
              <img src="images/gallery/temple.webp" alt="Historic Sri Lankan temple architecture" loading="lazy">
              <div class="gallery-item__overlay"><div class="gallery-item__zoom" aria-hidden="true">↗</div><h4 class="gallery-item__title">Sacred Heritage</h4><p class="gallery-item__location">Sri Lanka</p></div>
            </article>
            <article class="gallery-item gallery-item--wide" data-category="beaches" tabindex="0">
              <img src="images/gallery/beach.webp" alt="Golden tropical beach on the Sri Lankan coast" loading="lazy">
              <div class="gallery-item__overlay"><div class="gallery-item__zoom" aria-hidden="true">↗</div><h4 class="gallery-item__title">Island Coast</h4><p class="gallery-item__location">Southern Coast</p></div>
            </article>
          </div>

        </div>
      </section>

      <!-- CTA -->
      <section class="cta-section">
        <div class="cta-section__bg">
          <img loading="lazy" src="images/gallery/sigiriya.webp" alt="Sri Lanka scenery">
        </div>
        <div class="cta-section__overlay"></div>
        <div class="container">
          <div class="cta-section__content reveal">
            <h2>Want to See These Places in Person?</h2>
            <p>Let us create a personalized tour that brings these stunning destinations to life.</p>
            <a href="packages.html" class="btn btn--accent btn--lg">Browse Tour Packages</a>
          </div>
        </div>
      </section>

    </main>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
      <button class="lightbox__close" aria-label="Close">✕</button>
      <button class="lightbox__nav lightbox__prev" aria-label="Previous">←</button>
      <button class="lightbox__nav lightbox__next" aria-label="Next">→</button>
      <img loading="lazy" class="lightbox__image" src="" alt="">
      <div class="lightbox__caption">
        <h4></h4>
        <p></p>
      </div>
    </div>

    
</PageShell>
