---
import PageShell from '../layouts/PageShell.astro';

const galleryFiles = import.meta.glob('../data/gallery/*.json', { eager: true });
const galleryItems = Object.values(galleryFiles).map((file: any) => file.default);
---

<PageShell
  title="Gallery — Tourvir | Sri Lanka in Pictures"
  description="Explore the breathtaking beauty of Sri Lanka through our curated photo gallery — beaches, temples, wildlife, mountains, and cultural heritage."
  pageStyles={["css/pages/gallery.css?v=4"]}
  activeRoute="gallery.html"
>
<main class="main-content" id="main-content">

      <!-- Page Hero -->
      <section class="page-hero">
        <div class="page-hero__bg">
          <img src="images/hero/gallery_hero_bg.webp" alt="Sri Lanka Beach">
        </div>
        <div class="page-hero__overlay"></div>
        <div class="page-hero__content">
          <h1 class="page-hero__title">Photo Gallery</h1>
          <p class="page-hero__subtitle">Discover the breathtaking beauty of Sri Lanka through our curated collection</p>
          <div class="page-hero__breadcrumb">
            <a href="index.html">Home</a>
            <span>→</span>
            <span>Gallery</span>
          </div>
        </div>
      </section>

      <!-- Gallery Stats -->
      <section class="section">
        <div class="container">
          <div class="gallery-stats reveal">
            <div class="gallery-stat">
              <div class="gallery-stat__number">50+</div>
              <div class="gallery-stat__label">Destinations Captured</div>
            </div>
            <div class="gallery-stat">
              <div class="gallery-stat__number">200+</div>
              <div class="gallery-stat__label">Professional Photos</div>
            </div>
            <div class="gallery-stat">
              <div class="gallery-stat__number">8</div>
              <div class="gallery-stat__label">UNESCO Sites</div>
            </div>
          </div>

          <!-- Filter Pills -->
          <div class="filter-pills reveal">
            <button class="filter-pill active" data-filter="all">All</button>
            <button class="filter-pill" data-filter="beaches">Beaches</button>
            <button class="filter-pill" data-filter="temples">Temples</button>
            <button class="filter-pill" data-filter="wildlife">Wildlife</button>
            <button class="filter-pill" data-filter="mountains">Mountains</button>
            <button class="filter-pill" data-filter="culture">Culture</button>
            <button class="filter-pill" data-filter="heritage">Heritage</button>
          </div>

          <!-- Gallery Grid -->
          <div class="gallery-grid gallery-grid--masonry" id="gallery-dynamic-container">
            {galleryItems.map((item, index) => {
              const orientationClass = item.orientation === 'wide' ? 'gallery-item--wide' : item.orientation === 'tall' ? 'gallery-item--tall' : '';
              return (
                <article class={`gallery-item ${orientationClass}`} data-category={item.category} tabindex="0">
                  <img src={item.image} alt={item.alt || item.title} loading={index === 0 ? "eager" : "lazy"} />
                  <div class="gallery-item__overlay">
                    <div class="gallery-item__zoom" aria-hidden="true">↗</div>
                    <h4 class="gallery-item__title">{item.title}</h4>
                    <p class="gallery-item__location">{item.location}</p>
                  </div>
                </article>
              );
            })}
          </div>

        </div>
      </section>

      <!-- CTA -->
      <section class="cta-section">
        <div class="cta-section__bg">
          <img loading="lazy" src="images/gallery/sigiriya.webp" alt="Sri Lanka scenery">
        </div>
        <div class="cta-section__overlay"></div>
        <div class="container">
          <div class="cta-section__content reveal">
            <h2>Want to See These Places in Person?</h2>
            <p>Let us create a personalized tour that brings these stunning destinations to life.</p>
            <a href="packages.html" class="btn btn--accent btn--lg">Browse Tour Packages</a>
          </div>
        </div>
      </section>

    </main>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
      <button class="lightbox__close" aria-label="Close">✕</button>
      <button class="lightbox__nav lightbox__prev" aria-label="Previous">←</button>
      <button class="lightbox__nav lightbox__next" aria-label="Next">→</button>
      <img loading="lazy" class="lightbox__image" src="" alt="">
      <div class="lightbox__caption">
        <h4></h4>
        <p></p>
      </div>
    </div>

    
</PageShell>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Gallery Filtering ---
    const filterPills = document.querySelectorAll('.filter-pill');
    const galleryItems = document.querySelectorAll('.gallery-item');

    function applyFilter(category) {
      galleryItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (category === 'all' || itemCat === category) {
          item.style.display = ''; // Let grid layout handle it
        } else {
          item.style.display = 'none';
        }
      });
    }

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        applyFilter(pill.getAttribute('data-filter'));
      });
    });

    // --- Lightbox Functionality ---
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = lightbox.querySelector('.lightbox__image');
    const lightboxTitle = lightbox.querySelector('.lightbox__caption h4');
    const lightboxLoc = lightbox.querySelector('.lightbox__caption p');
    const closeBtn = lightbox.querySelector('.lightbox__close');
    const prevBtn = lightbox.querySelector('.lightbox__prev');
    const nextBtn = lightbox.querySelector('.lightbox__next');

    let currentItemIndex = -1;
    let visibleItems = []; // Only the items that match the current filter

    function getVisibleItems() {
      return Array.from(galleryItems).filter(item => item.style.display !== 'none');
    }

    function openLightbox(index) {
      visibleItems = getVisibleItems();
      currentItemIndex = index;
      
      const item = visibleItems[currentItemIndex];
      const img = item.querySelector('img');
      const title = item.querySelector('.gallery-item__title').textContent;
      const loc = item.querySelector('.gallery-item__location').textContent;

      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxTitle.textContent = title;
      lightboxLoc.textContent = loc;

      lightbox.classList.add('is-active');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    }

    function closeLightbox() {
      lightbox.classList.remove('is-active');
      document.body.style.overflow = '';
      setTimeout(() => {
        lightboxImg.src = '';
      }, 300); // Clear after fade out
    }

    function showNext() {
      if (visibleItems.length === 0) return;
      currentItemIndex = (currentItemIndex + 1) % visibleItems.length;
      openLightbox(currentItemIndex);
    }

    function showPrev() {
      if (visibleItems.length === 0) return;
      currentItemIndex = (currentItemIndex - 1 + visibleItems.length) % visibleItems.length;
      openLightbox(currentItemIndex);
    }

    // Attach click to items
    galleryItems.forEach(item => {
      item.addEventListener('click', () => {
        visibleItems = getVisibleItems();
        const index = visibleItems.indexOf(item);
        if (index !== -1) {
          openLightbox(index);
        }
      });
      // Keyboard support for items
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          visibleItems = getVisibleItems();
          const index = visibleItems.indexOf(item);
          if (index !== -1) openLightbox(index);
        }
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });

    // Allow clicking background to close
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-active')) return;
      
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowRight') showNext();
      else if (e.key === 'ArrowLeft') showPrev();
    });
  });
</script>
