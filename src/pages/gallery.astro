---
import PageShell from '../layouts/PageShell.astro';
import ResponsiveImage from '../components/ui/ResponsiveImage.astro';

const galleryFiles = import.meta.glob('../data/gallery/*.json', { eager: true });
const galleryItems = Object.values(galleryFiles).map((file: any) => file.default);
const galleryWidths: Record<string, number> = {
  'sigiriya.webp': 1920,
  'beach.webp': 1024,
  'elephant.webp': 1024,
  'tea_plantation.webp': 1024,
  'temple.webp': 360,
  'train.webp': 1024,
  'hero_18bends_hq.webp': 1920,
  'ChatGPT Image Jul 27, 2026, 10_51_57 AM.png': 1922,
};
const galleryImageWidth = (path: string) => galleryWidths[path.split('/').pop() || ''] ?? 1024;
---

<PageShell
  title="Gallery — Tourvir | Sri Lanka in Pictures"
  description="Explore the breathtaking beauty of Sri Lanka through our curated photo gallery — beaches, temples, wildlife, mountains, and cultural heritage."
  pageStyles={["css/pages/gallery.css?v=4"]}
  activeRoute="gallery.html"
>
<main class="main-content" id="main-content">

      <!-- Page Hero -->
      <section class="page-hero">
        <div class="page-hero__bg">
          <ResponsiveImage src="images/hero/gallery_hero_bg.webp" sourceWidth={1024} sizes="100vw" alt="Sri Lanka Beach" />
        </div>
        <div class="page-hero__overlay"></div>
        <div class="page-hero__content">
          <h1 class="page-hero__title">Photo Gallery</h1>
          <p class="page-hero__subtitle">Discover the breathtaking beauty of Sri Lanka through our curated collection</p>
          <div class="page-hero__breadcrumb">
            <a href="index.html">Home</a>
            <span>→</span>
            <span>Gallery</span>
          </div>
        </div>
      </section>

      <!-- Gallery Stats -->
      <section class="section">
        <div class="container">
          <div class="gallery-stats reveal">
            <div class="gallery-stat">
              <div class="gallery-stat__number">50+</div>
              <div class="gallery-stat__label">Destinations Captured</div>
            </div>
            <div class="gallery-stat">
              <div class="gallery-stat__number">200+</div>
              <div class="gallery-stat__label">Professional Photos</div>
            </div>
            <div class="gallery-stat">
              <div class="gallery-stat__number">8</div>
              <div class="gallery-stat__label">UNESCO Sites</div>
            </div>
          </div>

          <!-- Filter Pills -->
          <div class="filter-pills reveal">
            <button class="filter-pill active" data-filter="all" aria-pressed="true">All</button>
            <button class="filter-pill" data-filter="beaches" aria-pressed="false">Beaches</button>
            <button class="filter-pill" data-filter="temples" aria-pressed="false">Temples</button>
            <button class="filter-pill" data-filter="wildlife" aria-pressed="false">Wildlife</button>
            <button class="filter-pill" data-filter="mountains" aria-pressed="false">Mountains</button>
            <button class="filter-pill" data-filter="culture" aria-pressed="false">Culture</button>
            <button class="filter-pill" data-filter="heritage" aria-pressed="false">Heritage</button>
          </div>

          <!-- Gallery Grid -->
          <div class="gallery-grid gallery-grid--masonry" id="gallery-dynamic-container">
            {galleryItems.map((item, index) => {
              const orientationClass = item.orientation === 'wide' ? 'gallery-item--wide' : item.orientation === 'tall' ? 'gallery-item--tall' : '';
              return (
                <article class={`gallery-item ${orientationClass}`} data-category={item.category} tabindex="0" role="button" aria-label={`Open ${item.title} image`}>
                  <ResponsiveImage src={item.image} sourceWidth={galleryImageWidth(item.image)} sizes="(max-width: 767px) 100vw, (max-width: 1100px) 50vw, 33vw" alt={item.alt || item.title} loading={index === 0 ? "eager" : "lazy"} />
                  <div class="gallery-item__overlay">
                    <div class="gallery-item__zoom" aria-hidden="true">↗</div>
                    <h4 class="gallery-item__title">{item.title}</h4>
                    <p class="gallery-item__location">{item.location}</p>
                  </div>
                </article>
              );
            })}
          </div>

        </div>
      </section>

      <!-- CTA -->
      <section class="cta-section">
        <div class="cta-section__bg">
          <ResponsiveImage loading="lazy" src="images/gallery/sigiriya.webp" sourceWidth={1920} sizes="100vw" alt="Sri Lanka scenery" />
        </div>
        <div class="cta-section__overlay"></div>
        <div class="container">
          <div class="cta-section__content reveal">
            <h2>Want to See These Places in Person?</h2>
            <p>Let us create a personalized tour that brings these stunning destinations to life.</p>
            <a href="packages.html" class="btn btn--accent btn--lg">Browse Tour Packages</a>
          </div>
        </div>
      </section>

    </main>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Gallery image viewer" aria-hidden="true" inert>
      <button class="lightbox__close" aria-label="Close">✕</button>
      <button class="lightbox__nav lightbox__prev" aria-label="Previous">←</button>
      <button class="lightbox__nav lightbox__next" aria-label="Next">→</button>
      <img loading="lazy" class="lightbox__image" src="" alt="">
      <div class="lightbox__caption">
        <h4></h4>
        <p></p>
      </div>
    </div>

    
</PageShell>
