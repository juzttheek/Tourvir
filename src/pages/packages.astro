---
import PageShell from '../layouts/PageShell.astro';
import PackageGrid from '../components/packages/PackageGrid.astro';
---

<PageShell
  title="Tour Packages — Tourvir | Sri Lanka Tours"
  description="Choose from our curated Sri Lanka tour packages — Cultural Triangle, Beach Paradise, Wildlife Safari, Hill Country adventures, and more. Book your dream vacation today."
  pageStyles={["css/pages/packages.css"]}
  activeRoute="packages.html"
>
<main class="main-content" id="main-content">

      <!-- Page Hero -->
      <section class="page-hero">
        <div class="page-hero__bg">
          <img src="images/hero/packages_hero_bg.webp" alt="Sri Lanka Tour">
        </div>
        <div class="page-hero__overlay"></div>
        <div class="page-hero__content">
          <h1 class="page-hero__title">Tour Packages</h1>
          <p class="page-hero__subtitle">Handcrafted itineraries for every type of traveler</p>
          <div class="page-hero__breadcrumb">
            <a href="index.html">Home</a><span>→</span><span>Tour Packages</span>
          </div>
        </div>
      </section>

      <!-- Search & Filter -->
      <section class="section packages-section">
        <div class="container">

          <div class="packages-filter reveal">
            <div class="form-group">
              <label class="form-label">Search</label>
              <input type="text" class="form-input" id="package-search" placeholder="Search packages...">
            </div>
            <div class="form-group">
              <label class="form-label">Duration</label>
              <select class="form-select" id="package-duration">
                <option value="all">All Durations</option>
                <option value="short">1–4 Days</option>
                <option value="medium">5–7 Days</option>
                <option value="long">8+ Days</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Price Range</label>
              <select class="form-select" id="package-price">
                <option value="all">All Prices</option>
                <option value="budget">Under $500</option>
                <option value="mid">$500–$1,000</option>
                <option value="luxury">$1,000+</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Category</label>
              <select class="form-select" id="package-category">
                <option value="all">All Categories</option>
                <option value="cultural">Cultural</option>
                <option value="adventure">Adventure</option>
                <option value="beach">Beach</option>
                <option value="wildlife">Wildlife</option>
                <option value="honeymoon">Honeymoon</option>
              </select>
            </div>
            <button class="btn btn--primary" id="package-search-button">Search</button>
          </div>

          <!-- Featured Package -->
          <div class="featured-package reveal">
            <div class="featured-package__image-wrapper">
              <img loading="lazy" src="images/packages/complete_srilanka_experience.webp" alt="Complete Sri Lanka Tour" class="featured-package__image">
              <span class="featured-package__badge"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>Most Popular</span>
            </div>
            <div class="featured-package__body">
              <span class="featured-package__label"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M7 5H3"/><path d="M21 17v4"/><path d="M23 19h-4"/></svg>Featured Package</span>
              <h2 class="featured-package__title">Complete Sri Lanka Experience</h2>
              <p class="featured-package__desc">The ultimate 14-day journey covering Sri Lanka's most iconic destinations — from ancient ruins and misty hill country to golden beaches and wildlife sanctuaries. A comprehensive tour that captures the island's soul.</p>
              <div class="featured-package__highlights">
                <span class="featured-package__highlight"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>Sigiriya</span>
                <span class="featured-package__highlight"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>Yala Safari</span>
                <span class="featured-package__highlight"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect width="16" height="16" x="4" y="3" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="M8 15h.01"/><path d="M16 15h.01"/></svg>Ella Train</span>
                <span class="featured-package__highlight"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>Mirissa</span>
                <span class="featured-package__highlight"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>Kandy</span>
                <span class="featured-package__highlight"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M2 6c.6 0 1.2-.2 1.6-.6C4.1 4.9 4.8 4.6 5.5 4.6c.7 0 1.4.3 1.9.8.4.4 1 .6 1.6.6.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8.7 0 1.4.3 1.9.8.4.4 1 .6 1.6.6.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8.7 0 1.4.3 1.9.8.4.4 1 .6 1.6.6.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8s1.4.3 1.9.8c.4.4 1 .6 1.6.6"/><path d="M2 12c.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8.7 0 1.4.3 1.9.8.4.4 1 .6 1.6.6.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8.7 0 1.4.3 1.9.8.4.4 1 .6 1.6.6.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8s1.4.3 1.9.8c.4.4 1 .6 1.6.6"/><path d="M2 18c.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8.7 0 1.4.3 1.9.8.4.4 1 .6 1.6.6.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8.7 0 1.4.3 1.9.8.4.4 1 .6 1.6.6.6 0 1.2-.2 1.6-.6.5-.5 1.2-.8 1.9-.8s1.4.3 1.9.8c.4.4 1 .6 1.6.6"/></svg>Whale Watching</span>
                <span class="featured-package__highlight"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>14 Days</span>
              </div>
              <div class="featured-package__footer">
                <div class="featured-package__price">$1,899 <span>/ per person</span></div>
                <a href="/packages/package-7-complete-sri-lanka-experience.html" class="btn btn--primary">View Details</a>
              </div>
            </div>
          </div>

          <!-- Category Filters -->
          <div class="filter-pills legacy-util-22">
            <button class="filter-pill active" data-filter="all">All Packages</button>
            <button class="filter-pill" data-filter="cultural">Cultural</button>
            <button class="filter-pill" data-filter="adventure">Adventure</button>
            <button class="filter-pill" data-filter="beach">Beach</button>
            <button class="filter-pill" data-filter="wildlife">Wildlife</button>
            <button class="filter-pill" data-filter="honeymoon">Honeymoon</button>
          </div>

          <!-- Empty State (Hidden by default) -->
          <div id="packages-empty-state" class="reveal" style="display: none; text-align: center; padding: var(--space-3xl) 0;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 64px; height: 64px; color: var(--text-muted); margin-bottom: var(--space-md);"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <h3 style="margin-bottom: var(--space-sm);">No packages found</h3>
            <p style="color: var(--text-secondary); margin-bottom: var(--space-lg);">We couldn't find any packages matching your current filters.</p>
            <button class="btn btn--primary" id="clear-filters-btn">Clear All Filters</button>
          </div>

          <!-- Packages Grid -->
          <PackageGrid />

          <!-- Custom Package CTA -->
          <div class="reveal legacy-util-23">
            <p class="legacy-util-24">Can't find the perfect package? We'll create one just for you!</p>
            <a href="inquiry.html" class="btn btn--outline btn--lg">Request Custom Package</a>
          </div>

        </div>
      </section>

</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('package-search');
    const durationSelect = document.getElementById('package-duration');
    const priceSelect = document.getElementById('package-price');
    const categorySelect = document.getElementById('package-category');
    const filterPills = document.querySelectorAll('.filter-pill');
    const packageCards = document.querySelectorAll('.package-card');
    const featuredPackage = document.querySelector('.featured-package');
    const emptyState = document.getElementById('packages-empty-state');
    const clearFiltersBtn = document.getElementById('clear-filters-btn');
    const searchButton = document.getElementById('package-search-button');

    function applyFilters() {
      const searchTerm = searchInput.value.toLowerCase().trim();
      const durationVal = durationSelect.value;
      const priceVal = priceSelect.value;
      const categoryVal = categorySelect.value;

      // Check if any filter is active
      const hasActiveFilters = searchTerm !== '' || durationVal !== 'all' || priceVal !== 'all' || categoryVal !== 'all';

      // Hide or show featured package
      if (featuredPackage) {
        if (hasActiveFilters) {
          featuredPackage.style.display = 'none';
        } else {
          featuredPackage.style.display = 'flex';
        }
      }

      let visibleCount = 0;

      packageCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const duration = card.getAttribute('data-duration') || '';
        const price = parseInt(card.getAttribute('data-price') || '0', 10);
        const category = card.getAttribute('data-category') || '';

        let matchSearch = title.includes(searchTerm);
        let matchDuration = true;
        let matchPrice = true;
        let matchCategory = categoryVal === 'all' || category === categoryVal;

        const days = parseInt(duration, 10);
        if (durationVal === 'short') matchDuration = days <= 4;
        else if (durationVal === 'medium') matchDuration = days >= 5 && days <= 7;
        else if (durationVal === 'long') matchDuration = days >= 8;

        if (priceVal === 'budget') matchPrice = price < 500;
        else if (priceVal === 'mid') matchPrice = price >= 500 && price <= 1000;
        else if (priceVal === 'luxury') matchPrice = price > 1000;

        if (matchSearch && matchDuration && matchPrice && matchCategory) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.style.display = 'block';
        } else {
          emptyState.style.display = 'none';
        }
      }
    }

    searchInput.addEventListener('input', applyFilters);
    durationSelect.addEventListener('change', applyFilters);
    priceSelect.addEventListener('change', applyFilters);
    categorySelect.addEventListener('change', (e) => {
      filterPills.forEach(pill => {
        if (pill.getAttribute('data-filter') === e.target.value) {
          pill.classList.add('active');
        } else {
          pill.classList.remove('active');
        }
      });
      applyFilters();
    });

    searchButton.addEventListener('click', applyFilters);

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const filterVal = pill.getAttribute('data-filter');
        categorySelect.value = filterVal;
        applyFilters();
      });
    });

    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', () => {
        searchInput.value = '';
        durationSelect.value = 'all';
        priceSelect.value = 'all';
        categorySelect.value = 'all';
        filterPills.forEach(p => {
          if (p.getAttribute('data-filter') === 'all') {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
        applyFilters();
      });
    }
  });
</script>

</PageShell>
