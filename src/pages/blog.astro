---
import PageShell from '../layouts/PageShell.astro';
import { blogPosts } from '../data/blog';

const sortedPosts = blogPosts.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const title = 'Travel Blog & Guides - Tourvir';
const description = 'Read the latest travel guides, tips, and stories about exploring the incredible landscapes of Sri Lanka with Tourvir.';
---

<PageShell title={title} description={description} activeRoute="blog.html">

  <main id="main-content">
    <!-- Page Hero -->
    <section class="page-hero">
      <div class="page-hero__bg">
        <img src="images/hero/hero_tea_hq.webp" alt="Tourvir Blog - Travel Guides">
      </div>
      <div class="page-hero__overlay"></div>
      <div class="page-hero__content">
        <h1 class="page-hero__title">Tourvir Blog</h1>
        <p class="page-hero__subtitle">Discover hidden gems, packing tips, and inspiring stories from our adventures across Sri Lanka.</p>
        <div class="page-hero__breadcrumb">
          <a href="index.html">Home</a><span>→</span><span>Blog</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="grid grid--3">
          {sortedPosts.map((post) => (
            <a href={`/blog/${post.id}.html`} class="card" style="text-decoration: none; color: inherit;">
              <div class="card__image-wrapper">
                <img src={post.coverImage || '/images/hero/hero_main_hq.webp'} alt={post.title} class="card__image" loading="lazy" />
              </div>
              <div class="card__body">
                <div class="card__meta">
                  <span>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                </div>
                <h3 class="card__title" style="margin-top: 0.5rem;">{post.title}</h3>
                <p class="card__text">{post.description}</p>
                <span class="btn btn--ghost btn--sm" style="padding: 0; font-weight: 600;">Read More &rarr;</span>
              </div>
            </a>
          ))}
        </div>
        
        {sortedPosts.length === 0 && (
          <div style="text-align: center; padding: 4rem 0;">
            <p class="text-secondary">No blog posts found. Check back soon!</p>
          </div>
        )}
      </div>
    </section>
  </main>
</PageShell>
