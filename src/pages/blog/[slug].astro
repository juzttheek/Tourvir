---
import PageShell from '../../layouts/PageShell.astro';
import { blogPosts } from '../../data/blog';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';

export async function getStaticPaths() {
  return blogPosts.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const canonicalPath = `/blog/${entry.id}.html`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: entry.title,
  description: entry.description,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': 'Organization',
    name: entry.author || 'Tourvir Team',
    url: 'https://www.tourvir.lk/',
  },
  datePublished: new Date(entry.date).toISOString(),
  image: entry.coverImage
    ? new URL(entry.coverImage, Astro.site).href
    : 'https://www.tourvir.lk/images/hero/hero_main_hq.webp',
  publisher: {
    '@type': 'Organization',
    '@id': 'https://www.tourvir.lk/#organization',
    name: 'Tourvir',
    url: 'https://www.tourvir.lk/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.tourvir.lk/images/logo.png',
    },
  },
  isPartOf: {
    '@type': 'Blog',
    name: 'Tourvir Blog',
    url: 'https://www.tourvir.lk/blog.html',
  },
  inLanguage: 'en',
};
---

<PageShell 
  title={entry.seoTitle || `${entry.title} - Tourvir Blog`}
  description={entry.description}
  activeRoute="blog.html"
  image={entry.coverImage}
  imageAlt={entry.title}
  socialType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  </Fragment>
  <main class="page-container" id="main-content" style="padding-top: calc(var(--header-height) + var(--top-bar-height) + var(--safe-top));">
    <article class="prose" style="max-width: 800px; margin: 0 auto; padding: var(--space-xl) var(--space-md);">
      <Breadcrumbs className="content-breadcrumb" items={[
        { name: 'Home', href: '/' },
        { name: 'Blog', href: '/blog.html' },
        { name: entry.title, href: canonicalPath },
      ]} />
      <header style="text-align: center; margin-bottom: var(--space-xl);">
        <h1 style="font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin-bottom: var(--space-md);">{entry.title}</h1>
        <div style="color: var(--text-tertiary); font-size: 0.95rem; margin-bottom: var(--space-lg);">
          {new Date(entry.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} • By {entry.author}
        </div>
        {entry.coverImage && (
          <img 
            src={entry.coverImage} 
            alt={entry.title} 
            style="width: 100%; height: auto; max-height: 500px; object-fit: cover; border-radius: var(--radius-lg);"
          />
        )}
      </header>
      <div class="content" style="font-size: 1.1rem; line-height: 1.8;">
        <p>{entry.content}</p>
      </div>
    </article>
  </main>
</PageShell>
