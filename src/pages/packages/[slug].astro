---
import PageShell from '../../layouts/PageShell.astro';
import RouteMap from '../../components/packages/RouteMap.astro';
import { tourPackages } from '../../content/catalogs';

export async function getStaticPaths() {
  return tourPackages.map(pkg => ({
    params: { slug: pkg.id },
    props: { pkg },
  }));
}

const { pkg } = Astro.props;
---

<PageShell
  title={`${pkg.title} - Tourvir`}
  description={`Discover the amazing ${pkg.title} package in Sri Lanka.`}
  activeRoute="packages.html"
>
  <main class="main-content" id="main-content" style="padding-top: var(--header-height);">
    <section class="section">
      <div class="container">
        <!-- Back button -->
        <a href="/packages.html" class="btn btn--ghost btn--sm" style="margin-bottom: var(--space-lg);">← Back to Packages</a>

        <div class="package-detail-header" style="text-align: center; margin-bottom: var(--space-xl);">
          <span class="badge badge--primary" style="margin-bottom: var(--space-sm); display: inline-block;">{pkg.categoryLabel}</span>
          <h1 class="heading-1">{pkg.title}</h1>
          <div style="font-size: 1.1rem; color: var(--text-secondary); margin-top: var(--space-sm);" set:html={pkg.durationMarkup}></div>
        </div>

        <div class="grid grid--2" style="align-items: start; gap: var(--space-xl);">
          <!-- Left Column (Image & Highlights) -->
          <div>
            <img 
              src={`/${pkg.image}`} 
              alt={pkg.alt} 
              style="width: 100%; border-radius: var(--radius-lg); margin-bottom: var(--space-lg); box-shadow: var(--shadow-md);"
            />
            
            <h3 style="margin-bottom: var(--space-sm);">Tour Highlights</h3>
            <ul style="list-style: none; padding: 0; margin: 0 0 var(--space-xl) 0;">
              {pkg.highlights.map(h => (
                <li style="margin-bottom: var(--space-sm); display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem;">
                  <svg style="color: var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M20 6L9 17l-5-5"></path></svg>
                  {h}
                </li>
              ))}
            </ul>

            {pkg.recommendedVehicles && pkg.recommendedVehicles.length > 0 && (
              <div style="background: var(--bg-secondary); padding: var(--space-md); border-radius: var(--radius-md); border: 1px solid var(--border-color); margin-bottom: var(--space-xl);">
                <h4 style="margin-top: 0; margin-bottom: var(--space-sm);">Recommended Vehicles</h4>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem;">
                  {pkg.recommendedVehicles.map(v => (
                    <li style="background: var(--bg-body); padding: 0.25rem 0.75rem; border-radius: 100px; font-size: 0.875rem; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.25rem;">
                      <svg style="color: var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle></svg>
                      {v}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {pkg.itinerary && pkg.itinerary.length > 0 && (
              <div style="margin-top: var(--space-2xl);">
                <h3 style="margin-bottom: var(--space-lg);">Itinerary</h3>
                <div class="itinerary-timeline">
                  {pkg.itinerary.map((item, index) => (
                    <div class="timeline-item">
                      <div class="timeline-dot"></div>
                      <div class="timeline-content">
                        <div class="timeline-day">{item.day}</div>
                        <h4 class="timeline-title">{item.title}</h4>
                        <p class="timeline-desc">{item.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Right Column (Booking info & Map) -->
          <div>
            <div style="background: var(--bg-secondary); padding: var(--space-lg); border-radius: var(--radius-lg); border: 1px solid var(--border-color); margin-bottom: var(--space-xl);">
              <h2 style="margin-top: 0; margin-bottom: var(--space-sm);">Pricing</h2>
              <div style="font-size: 1.5rem; font-weight: 700; color: var(--color-primary); margin-bottom: var(--space-lg);" set:html={pkg.priceMarkup}></div>
              
              <a href="/inquiry.html" class="btn btn--primary" style="width: 100%; justify-content: center; margin-bottom: var(--space-sm);">Inquire About This Tour</a>
              <p class="text-secondary" style="font-size: 0.875rem; text-align: center; margin: 0;">No credit card required</p>
            </div>

            <RouteMap routeMap={pkg.routeMap} />
          </div>
        </div>
      </div>
    </section>
  </main>
</PageShell>
