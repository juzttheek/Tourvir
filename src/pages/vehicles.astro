---
import PageShell from '../layouts/PageShell.astro';
import VehicleGrid from '../components/vehicles/VehicleGrid.astro';
---

<PageShell
  title="Vehicles — Tourvir | Tourist Transport in Sri Lanka"
  description="Explore Tourvir's fleet of comfortable tourist vehicles — sedans, SUVs, vans, luxury cars, and coach buses. All with experienced English-speaking chauffeurs."
  pageStyles={["css/pages/vehicles.css"]}
  activeRoute="vehicles.html"
>
<main class="main-content" id="main-content">

      <!-- Page Hero -->
      <section class="page-hero">
        <div class="page-hero__bg">
          <img src="images/hero/vehicles_hero_bg.webp" alt="Sri Lanka road journey">
        </div>
        <div class="page-hero__overlay"></div>
        <div class="page-hero__content">
          <h1 class="page-hero__title">Our Vehicle Fleet</h1>
          <p class="page-hero__subtitle">Travel in comfort with our well-maintained fleet and expert chauffeurs</p>
          <div class="page-hero__breadcrumb">
            <a href="index.html">Home</a><span>→</span><span>Vehicles</span>
          </div>
        </div>
      </section>

      <!-- Vehicle Fleet -->
      <section class="section">
        <div class="container">
          <div class="section__header reveal">
            <span class="section__label">Our Fleet</span>
            <h2 class="section__title">Choose Your Perfect Ride</h2>
            <p class="section__subtitle">From compact sedans to luxury coaches, we have the right vehicle for every journey and group size.</p>
          </div>

          <VehicleGrid />
        </div>
      </section>

      <!-- Chauffeur Section -->
      <section class="section section--alt">
        <div class="container">
          <div class="chauffeur-section">
            <div class="chauffeur__image-wrapper reveal-left">
              <img loading="lazy" src="images/team/sri_lankan_chauffeur.webp" alt="Professional Chauffeur" class="chauffeur__image">
            </div>
            <div class="chauffeur__content reveal-right">
              <span class="section__label">Professional Service</span>
              <h3>Expert Chauffeur-Guides</h3>
              <p>All our vehicles come with experienced, English-speaking chauffeur-guides who double as local experts. They know the best routes, hidden restaurants, and scenic stops.</p>
              <p>Your driver is your travel companion — friendly, knowledgeable, and committed to making your Sri Lanka experience unforgettable.</p>
              <div class="chauffeur__features">
                <div class="chauffeur__feature">
                  <div class="chauffeur__feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></div>
                  <span class="chauffeur__feature-text">Nationally Certified & Licensed Drivers</span>
                </div>
                <div class="chauffeur__feature">
                  <div class="chauffeur__feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-languages"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg></div>
                  <span class="chauffeur__feature-text">Fluent English Speakers</span>
                </div>
                <div class="chauffeur__feature">
                  <div class="chauffeur__feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
                  <span class="chauffeur__feature-text">Extensive Local Knowledge</span>
                </div>
                <div class="chauffeur__feature">
                  <div class="chauffeur__feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div>
                  <span class="chauffeur__feature-text">Fully Insured & Background Verified</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Comparison Table -->
      <section class="section">
        <div class="container">
          <div class="section__header reveal">
            <span class="section__label">Compare</span>
            <h2 class="section__title">Vehicle Comparison</h2>
            <p class="section__subtitle">Find the perfect vehicle that matches your needs and group size.</p>
          </div>

          <div class="comparison-table-wrapper reveal">
            <table class="comparison-table">
              <thead>
                <tr>
                  <th>Feature</th>
                  <th>Sedan</th>
                  <th>Lux Sedan</th>
                  <th>Mini SUV</th>
                  <th>SUV</th>
                  <th>Lux SUV</th>
                  <th>Van</th>
                  <th>Coach</th>
                  <th>Tuk-Tuk</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Passengers</strong></td>
                  <td>2-3</td>
                  <td>2-3</td>
                  <td>3-4</td>
                  <td>4-5</td>
                  <td>5-6</td>
                  <td>6-8</td>
                  <td>20-40</td>
                  <td>2</td>
                </tr>
                <tr>
                  <td><strong>Air Conditioning</strong></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="cross">✗</span></td>
                </tr>
                <tr>
                  <td><strong>WiFi</strong></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="cross">✗</span></td>
                </tr>
                <tr>
                  <td><strong>Luggage Space</strong></td>
                  <td>Medium</td>
                  <td>Medium</td>
                  <td>Medium</td>
                  <td>Large</td>
                  <td>Large</td>
                  <td>Extra Large</td>
                  <td>Extra Large</td>
                  <td>Small</td>
                </tr>
                <tr>
                  <td><strong>Off-Road</strong></td>
                  <td><span class="cross">✗</span></td>
                  <td><span class="cross">✗</span></td>
                  <td><span class="cross">✗</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="check">✓</span></td>
                  <td><span class="cross">✗</span></td>
                  <td><span class="cross">✗</span></td>
                  <td><span class="check">✓</span></td>
                </tr>
                <tr>
                  <td><strong>Best For</strong></td>
                  <td>Couples</td>
                  <td>VIPs</td>
                  <td>Small Families</td>
                  <td>Families</td>
                  <td>Premium Travel</td>
                  <td>Groups</td>
                  <td>Large Groups</td>
                  <td>City Fun</td>
                </tr>
                <tr>
                <td><strong>Daily Rate</strong></td>
                  <td><strong>$90</strong></td>
                  <td><strong>$150</strong></td>
                  <td><strong>$100</strong></td>
                  <td><strong>$130</strong></td>
                  <td><strong>$150</strong></td>
                  <td><strong>$75</strong></td>
                  <td><strong>$200</strong></td>
                  <td><strong>$25</strong></td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="reveal legacy-util-25">
            <a href="inquiry.html" class="btn btn--primary btn--lg">Reserve a Vehicle</a>
          </div>
        </div>
      </section>

    </main>
</PageShell>
