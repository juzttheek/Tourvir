                <div class="feedback-form__stars" id="feedback-stars">
                  <button type="button" class="feedback-form__star" data-rating="1" aria-label="1 star">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </button>
                  <button type="button" class="feedback-form__star" data-rating="2" aria-label="2 stars">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </button>
                  <button type="button" class="feedback-form__star" data-rating="3" aria-label="3 stars">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </button>
                  <button type="button" class="feedback-form__star" data-rating="4" aria-label="4 stars">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </button>
                  <button type="button" class="feedback-form__star" data-rating="5" aria-label="5 stars">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </button>
                </div>
                <input type="hidden" id="feedback-rating" name="rating" value="0">
              </div>
              <div class="feedback-form__group">
                <label for="feedback-message" class="feedback-form__label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  Your Experience
                </label>
                <textarea id="feedback-message" class="feedback-form__input feedback-form__textarea" placeholder="Tell us what you loved about your trip, your favourite moments, or anything we could improve..." rows="5" required aria-required="true"></textarea>
              </div>
              <div class="feedback-form__group checkbox-group" style="margin-top: 1.5rem; align-items: flex-start; gap: 0.5rem; display: flex;">
                <input type="checkbox" id="feedback-consent" required aria-required="true" style="margin-top: 0.25rem;">
                <label for="feedback-consent" style="font-size: 0.875rem; color: var(--color-gray-600); line-height: 1.4;">I consent to Tourvir using my feedback and name as a testimonial on the website. *</label>
              </div>
              <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button type="submit" class="btn btn--primary btn--lg feedback-form__submit" id="feedback-submit" style="margin-top: 1.5rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
