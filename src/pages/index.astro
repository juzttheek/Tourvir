---
import PageShell from '../layouts/PageShell.astro';

const testimonialFiles = import.meta.glob('../data/testimonials/*.json', { eager: true });
const testimonials = Object.values(testimonialFiles).map((file: any) => file.default);
---

<PageShell
  title="Tourvir - Discover Sri Lanka | Premier Tourist Guide"
  description="Tourvir - Your premier Sri Lanka travel companion. Discover the Pearl of the Indian Ocean with curated tour packages, expert guides, and unforgettable experiences."
  pageStyles={["css/pages/home.css"]}
  activeRoute="index.html"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "TravelAgency",
        "name": "Tourvir",
        "image": "https://tourvir.lk/images/hero/hero_main_hq.webp",
        "description": "Your premier Sri Lanka travel companion. Discover the Pearl of the Indian Ocean with curated tour packages, expert guides, and unforgettable experiences.",
        "url": "https://tourvir.lk",
        "telephone": "+94112345678",
        "email": "hello@tourvir.lk",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "42 Galle Road",
          "addressLocality": "Colombo 03",
          "addressCountry": "LK"
        },
        "sameAs": [
          "https://facebook.com/tourvir",
          "https://instagram.com/tourvir"
        ]
      }
    </script>
  </Fragment>

<main class="main-content" id="main-content">

      <!-- ===== HERO SECTION ===== -->
      <section class="hero" id="hero">
        <div class="hero__bg" id="hero-slider">
          <!-- Eagerly loaded first asset -->
          <img src="images/hero/hero_main_hq.webp" class="active" alt="Sigiriya rock fortress at sunset" fetchpriority="high">
          <!-- Subsequent lazy assets for slider -->
          <img src="images/hero/hero_train_hq.webp" alt="Beautiful Ella train journey" loading="lazy">
          <img src="images/hero/hero_wild_hq.webp" alt="Majestic wild elephant at sunset" loading="lazy">
        </div>
        
        <!-- Hero Slider Controls -->
        <button class="hero__pause-btn" id="hero-pause-btn" aria-label="Pause slider" title="Pause slider">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <rect x="6" y="4" width="4" height="16" rx="1"></rect>
            <rect x="14" y="4" width="4" height="16" rx="1"></rect>
          </svg>
        </button>
        
        <div class="hero__overlay"></div>
        <div class="hero__particles">
          <div class="hero__particle"></div>
          <div class="hero__particle"></div>
          <div class="hero__particle"></div>
          <div class="hero__particle"></div>
          <div class="hero__particle"></div>
          <div class="hero__particle"></div>
          <div class="hero__particle"></div>
          <div class="hero__particle"></div>
        </div>
        <div class="hero__content">
          <span class="hero__label">🌴 Welcome to Sri Lanka</span>
          <h1 class="hero__title">Discover the <span>Pearl of the Indian Ocean</span></h1>
          <p class="hero__subtitle">Experience ancient wonders, pristine beaches, lush mountains, and vibrant culture with Tourvir - your trusted travel companion in Sri Lanka.</p>
          <div class="hero__buttons">
            <a href="packages.html" class="btn btn--accent btn--lg">Explore Packages</a>
            <a href="gallery.html" class="btn btn--outline btn--lg legacy-util-13">View Gallery</a>
          </div>
        </div>
        <div class="hero__scroll-indicator">↓</div>
      </section>



      <!-- ===== ABOUT SECTION ===== -->
      <section class="section" id="about">
        <div class="container">
          <div class="about-grid reveal">
            <div class="about__image-wrapper reveal-left">
              <img loading="lazy" src="images/gallery/sigiriya.webp" alt="Sigiriya Rock Fortress" class="about__image">
              <div class="about__image-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg> 10+ Years of Excellence</div>
            </div>
            <div class="about__text reveal-right">
              <span class="section__label">About Tourvir</span>
              <h2>Your Gateway to <br>Sri Lanka's Wonders</h2>
              <p>Founded in 2015, Tourvir has been the premier choice for international travelers seeking authentic Sri Lankan experiences. We combine local expertise with world-class service to create journeys that go beyond ordinary tourism.</p>
              <p>Our team of passionate travel experts and certified guides ensures every trip is tailored to your dreams — from the ancient ruins of Anuradhapura to the golden beaches of Bentota.</p>
              <div class="about__highlights">
                <div class="about__highlight">
                  <span class="about__highlight-icon">✓</span>
                  Licensed & Certified
                </div>
                <div class="about__highlight">
                  <span class="about__highlight-icon">✓</span>
                  24/7 Traveler Support
                </div>
                <div class="about__highlight">
                  <span class="about__highlight-icon">✓</span>
                  Customized Itineraries
                </div>
                <div class="about__highlight">
                  <span class="about__highlight-icon">✓</span>
                  Sustainable Tourism
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== STATS SECTION ===== -->
      <section class="section section--alt" id="stats">
        <div class="container">
          <div class="stats">
            <div class="stat reveal delay-1">
              <div class="stat__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></div>
              <div class="stat__number" data-count="5000" data-suffix="+">0</div>
              <div class="stat__label">Happy Tourists</div>
            </div>
            <div class="stat reveal delay-2">
              <div class="stat__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 15 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></div>
              <div class="stat__number" data-count="50" data-suffix="+">0</div>
              <div class="stat__label">Destinations</div>
            </div>
            <div class="stat reveal delay-3">
              <div class="stat__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
              <div class="stat__number" data-count="10" data-suffix="+">0</div>
              <div class="stat__label">Years Experience</div>
            </div>
            <div class="stat reveal delay-4">
              <div class="stat__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg></div>
              <div class="stat__number" data-count="98" data-suffix="%">0</div>
              <div class="stat__label">Satisfaction Rate</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== OUR SERVICES ===== -->
      <section class="section" id="services">
        <div class="container">
          <div class="section__header reveal">
            <span class="section__label">What We Offer</span>
            <h2 class="section__title">Our Services</h2>
            <p class="section__subtitle">From curated island tours to seamless airport transfers — we handle every detail so you can focus on making memories.</p>
          </div>
          <div class="services-grid">

            <div class="service-card reveal delay-1">
              <div class="service-card__image-wrap">
                <img loading="lazy" src="images/services/sri-lanka-tours.webp" alt="Sri Lanka Tours" class="service-card__image">
              </div>
              <div class="service-card__icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
              </div>
              <div class="service-card__body">
                <h4 class="service-card__title">Sri Lanka Tours</h4>
                <p class="service-card__desc">Expertly crafted itineraries across the island's most breathtaking destinations.</p>
                <a href="contact.html" class="service-card__link">Get in Touch <span>→</span></a>
              </div>
            </div>

            <div class="service-card reveal delay-2">
              <div class="service-card__image-wrap">
                <img loading="lazy" src="images/services/outbound-holidays.webp" alt="Outbound Holidays" class="service-card__image">
              </div>
              <div class="service-card__icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
              </div>
              <div class="service-card__body">
                <h4 class="service-card__title">Outbound Holidays</h4>
                <p class="service-card__desc">Explore international destinations with our carefully planned holiday packages.</p>
                <a href="contact.html" class="service-card__link">Get in Touch <span>→</span></a>
              </div>
            </div>

            <div class="service-card reveal delay-3">
              <div class="service-card__image-wrap">
                <img loading="lazy" src="images/services/airport-transfers.webp" alt="Airport Transfers" class="service-card__image">
              </div>
              <div class="service-card__icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
              </div>
              <div class="service-card__body">
                <h4 class="service-card__title">Airport Transfers</h4>
                <p class="service-card__desc">Punctual, comfortable pick-ups and drop-offs at Bandaranaike International Airport.</p>
                <a href="contact.html" class="service-card__link">Get in Touch <span>→</span></a>
              </div>
            </div>

            <div class="service-card reveal delay-4">
              <div class="service-card__image-wrap">
                <img loading="lazy" src="images/services/hotel-booking.webp" alt="Hotel Booking" class="service-card__image">
              </div>
              <div class="service-card__icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><path d="M12 4v6"/><path d="M2 18h20"/></svg>
              </div>
              <div class="service-card__body">
                <h4 class="service-card__title">Hotel Booking</h4>
                <p class="service-card__desc">Handpicked stays from boutique villas to luxury resorts at the best rates.</p>
                <a href="contact.html" class="service-card__link">Get in Touch <span>→</span></a>
              </div>
            </div>

            <div class="service-card reveal delay-1">
              <div class="service-card__image-wrap">
                <img loading="lazy" src="images/services/visa-assistance.webp" alt="Visa Assistance" class="service-card__image">
              </div>
              <div class="service-card__icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/></svg>
              </div>
              <div class="service-card__body">
                <h4 class="service-card__title">Visa Assistance</h4>
                <p class="service-card__desc">Hassle-free visa processing and guidance for a smooth entry into Sri Lanka.</p>
                <a href="contact.html" class="service-card__link">Get in Touch <span>→</span></a>
              </div>
            </div>

            <div class="service-card reveal delay-2">
              <div class="service-card__image-wrap">
                <img loading="lazy" src="images/services/vehicle-rental.webp" alt="Vehicle Rental" class="service-card__image">
              </div>
              <div class="service-card__icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              </div>
              <div class="service-card__body">
                <h4 class="service-card__title">Vehicle Rental</h4>
                <p class="service-card__desc">Self-drive or chauffeur-driven vehicles — sedans, SUVs, vans, and luxury cars.</p>
                <a href="contact.html" class="service-card__link">Get in Touch <span>→</span></a>
              </div>
            </div>

            <div class="service-card reveal delay-3">
              <div class="service-card__image-wrap">
                <img loading="lazy" src="images/services/tailor-made-tours.webp" alt="Tailor-made Tours" class="service-card__image">
              </div>
              <div class="service-card__icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
              </div>
              <div class="service-card__body">
                <h4 class="service-card__title">Tailor-made Tours</h4>
                <p class="service-card__desc">Design your dream trip — you set the pace, we make it happen.</p>
                <a href="contact.html" class="service-card__link">Get in Touch <span>→</span></a>
              </div>
            </div>

          </div>

          <div class="services-cta reveal">
            <p>Interested in any of our services? Our travel experts are ready to help you plan the perfect experience.</p>
            <a href="contact.html" class="btn btn--primary btn--lg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              Contact Us for Details
            </a>
          </div>
        </div>
      </section>

      <!-- ===== WHY CHOOSE US ===== -->
      <section class="section" id="why-us">
        <div class="container">
          <div class="section__header reveal">
            <span class="section__label">Why Choose Us</span>
            <h2 class="section__title">What Makes Tourvir Special</h2>
            <p class="section__subtitle">We don't just plan trips — we craft unforgettable experiences that connect you with the heart of Sri Lanka.</p>
          </div>
          <div class="features-grid">
            <div class="feature-card reveal delay-1">
              <div class="feature-card__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/></svg></div>
              <h4 class="feature-card__title">Expert Local Guides</h4>
              <p class="feature-card__text">Our certified guides bring stories to life with deep local knowledge and fluent English.</p>
            </div>
            <div class="feature-card reveal delay-2">
              <div class="feature-card__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
              <h4 class="feature-card__title">Tailored Experiences</h4>
              <p class="feature-card__text">Every itinerary is customized to your interests, pace, and budget. No cookie-cutter tours.</p>
            </div>
            <div class="feature-card reveal delay-3">
              <div class="feature-card__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></div>
              <h4 class="feature-card__title">Safe & Reliable</h4>
              <p class="feature-card__text">Licensed vehicles, insured trips, and 24/7 support for complete peace of mind.</p>
            </div>
            <div class="feature-card reveal delay-4">
              <div class="feature-card__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg></div>
              <h4 class="feature-card__title">Eco-Friendly Travel</h4>
              <p class="feature-card__text">We partner with sustainable lodges and support local communities on every journey.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== TOP DESTINATIONS ===== -->
      <section class="section section--alt" id="destinations">
        <div class="container">
          <div class="section__header reveal">
            <span class="section__label">Top Destinations</span>
            <h2 class="section__title">Places You'll Love</h2>
            <p class="section__subtitle">From ancient ruins to tropical beaches, Sri Lanka offers a world of wonder in one small island.</p>
          </div>
          <div class="destinations-grid">
            <div class="destination-card reveal delay-1">
              <img loading="lazy" src="images/gallery/sigiriya.webp" alt="Sigiriya Rock Fortress">
              <div class="destination-card__overlay">
                <h3 class="destination-card__name">Sigiriya</h3>
                <p class="destination-card__desc">Ancient rock fortress & UNESCO site</p>
              </div>
            </div>
            <div class="destination-card reveal delay-2">
              <img loading="lazy" src="images/gallery/beach.webp" alt="Tropical Beach in Sri Lanka">
              <div class="destination-card__overlay">
                <h3 class="destination-card__name">Southern Coast</h3>
                <p class="destination-card__desc">Golden beaches & turquoise waters</p>
              </div>
            </div>
            <div class="destination-card reveal delay-3">
              <img loading="lazy" src="images/gallery/temple.webp" alt="Temple of the Tooth Relic">
              <div class="destination-card__overlay">
                <h3 class="destination-card__name">Kandy</h3>
                <p class="destination-card__desc">Temple of the Tooth & hill capital</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== TESTIMONIALS ===== -->
      <section class="section testimonials-section" id="testimonials">
        <div class="container">
          <div class="section__header reveal">
            <span class="section__label">Testimonials</span>
            <h2 class="section__title">What Our Travelers Say</h2>
            <p class="section__subtitle">Hear from tourists who experienced the magic of Sri Lanka with Tourvir.</p>
          </div>
          <div class="testimonials__wrapper reveal">
            <div class="testimonials__carousel">
              <div class="testimonials__track">
                {testimonials.map((t) => (
                  <div class="testimonial">
                    <div class="stars legacy-util-14">{"★".repeat(t.rating)}</div>
                    <p class="testimonial__quote">{t.quote}</p>
                    <p class="testimonial__name">{t.name}</p>
                    <p class="testimonial__origin">{t.origin}</p>
                  </div>
                ))}
              </div>
              <div class="testimonials__dots">
                {testimonials.map((_, i) => (
                  <button class={`testimonials__dot ${i === 0 ? 'active' : ''}`} aria-label={`Testimonial ${i + 1}`}></button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== CUSTOMER FEEDBACK FORM ===== -->
      <section class="section section--alt" id="feedback">
        <div class="container">
          <div class="section__header reveal">
            <span class="section__label">Share Your Experience</span>
            <h2 class="section__title">We'd Love Your Feedback</h2>
            <p class="section__subtitle">Traveled with Tourvir? Tell us about your experience and help future travelers discover Sri Lanka.</p>
          </div>
          <div class="feedback-form-wrapper reveal">
            <form class="feedback-form" id="feedback-form">
              <div class="feedback-form__row">
                <div class="feedback-form__group">
                  <label for="feedback-name" class="feedback-form__label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Full Name
                  </label>
                  <input type="text" id="feedback-name" class="feedback-form__input" placeholder="e.g. Sarah Mitchell" required aria-required="true">
                </div>
                <div class="feedback-form__group">
                  <label for="feedback-email" class="feedback-form__label">
