---
import PageShell from '../layouts/PageShell.astro';
---

<PageShell
  title="Inquiry — Tourvir | Plan Your Sri Lanka Trip"
  description="Plan your dream Sri Lanka vacation with Tourvir. Fill out our easy multi-step inquiry form and our travel experts will design a personalized itinerary for you."
  pageStyles={["css/pages/inquiry.css?v=2"]}
  activeRoute="inquiry.html"
>
<main class="main-content" id="main-content">

      <!-- Page Hero -->
      <section class="page-hero">
        <div class="page-hero__bg">
          <img src="images/hero/inquiry_hero_bg.webp" alt="Plan your trip">
        </div>
        <div class="page-hero__overlay"></div>
        <div class="page-hero__content">
          <h1 class="page-hero__title">Plan Your Dream Trip</h1>
          <p class="page-hero__subtitle">Tell us about your ideal Sri Lanka adventure and we'll design it for you</p>
          <div class="page-hero__breadcrumb">
            <a href="index.html">Home</a><span>→</span><span>Inquiry</span>
          </div>
        </div>
      </section>

      <!-- Inquiry Form Section -->
      <section class="section">
        <div class="container">

          <!-- Progress Steps -->
          <div class="progress-steps reveal">
            <div class="progress-step active">
              <div class="progress-step__circle">1</div>
              <span class="progress-step__label">Personal Info</span>
            </div>
            <div class="progress-step__line"></div>
            <div class="progress-step">
              <div class="progress-step__circle">2</div>
              <span class="progress-step__label">Trip Details</span>
            </div>
            <div class="progress-step__line"></div>
            <div class="progress-step">
              <div class="progress-step__circle">3</div>
              <span class="progress-step__label">Preferences</span>
            </div>
            <div class="progress-step__line"></div>
            <div class="progress-step">
              <div class="progress-step__circle">4</div>
              <span class="progress-step__label">Review</span>
            </div>
          </div>

          <div class="inquiry-layout">

            <!-- Multi-Step Form -->
            <div class="inquiry-form-wrapper reveal">
              <form id="inquiry-form">

                <!-- Step 1: Personal Details -->
                <div class="form-step active">
                  <h3 class="form-step__title">Personal Information</h3>
                  <p class="form-step__subtitle">Let us know who you are so we can personalize your experience.</p>

                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="full-name">Full Name *</label>
                      <input type="text" class="form-input" id="full-name" placeholder="John Smith" required aria-required="true">
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="email">Email Address *</label>
                      <input type="email" class="form-input" id="email" placeholder="john@example.com" required aria-required="true">
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="nationality">Nationality *</label>
                      <select class="form-select" id="nationality" required aria-required="true">
                        <option value="">Select your country</option>
                        <option value="AU">Australia</option>
                        <option value="CA">Canada</option>
                        <option value="CN">China</option>
                        <option value="FR">France</option>
                        <option value="DE">Germany</option>
                        <option value="IN">India</option>
                        <option value="JP">Japan</option>
                        <option value="NL">Netherlands</option>
                        <option value="RU">Russia</option>
                        <option value="GB">United Kingdom</option>
                        <option value="US">United States</option>
                        <option value="other">Other</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="phone">Phone / WhatsApp</label>
                      <input type="tel" class="form-input" id="phone" placeholder="+1 234 567 8900">
                    </div>
                  </div>

                  <div class="form-actions">
                    <div></div>
                    <button type="button" class="btn btn--primary" data-action="next">Next Step →</button>
                  </div>
                </div>

                <!-- Step 2: Trip Details -->
                <div class="form-step">
                  <h3 class="form-step__title">Trip Details</h3>
                  <p class="form-step__subtitle">Tell us when you're planning to visit and what excites you.</p>

                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="arrival-date">Arrival Date *</label>
                      <input type="date" class="form-input" id="arrival-date" required aria-required="true">
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="departure-date">Departure Date *</label>
                      <input type="date" class="form-input" id="departure-date" required aria-required="true">
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="travelers">Number of Travelers *</label>
                    <select class="form-select" id="travelers" required aria-required="true">
                      <option value="">Select number</option>
                      <option value="1">1 - Solo Traveler</option>
                      <option value="2">2 - Couple</option>
                      <option value="3-4">3-4 - Small Group</option>
                      <option value="5-8">5-8 - Family / Group</option>
                      <option value="9+">9+ - Large Group</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label class="form-label">Interests (Select all that apply)</label>
                    <div class="interest-tags">
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>Historical Sites</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>Beaches</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>Wildlife Safari</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>Nature & Hiking</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>Food & Cuisine</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>Ayurveda & Wellness</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>Photography</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><circle cx="12" cy="5" r="3"/><line x1="12" y1="22" x2="12" y2="8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/></svg>Water Sports</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect width="16" height="16" x="4" y="3" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="M8 15h.01"/><path d="M16 15h.01"/></svg>Scenic Train Rides</button>
                      <button type="button" class="interest-tag"><svg class="legacy-util-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.46 2 12 2z"/></svg>Culture & Traditions</button>
                    </div>
                  </div>

                  <div class="form-actions">
                    <button type="button" class="btn btn--ghost" data-action="prev">← Previous</button>
                    <button type="button" class="btn btn--primary" data-action="next">Next Step →</button>
                  </div>
                </div>

                <!-- Step 3: Preferences -->
                <div class="form-step">
                  <h3 class="form-step__title">Your Preferences</h3>
                  <p class="form-step__subtitle">Help us match the right level of comfort and service to your taste.</p>

                  <div class="form-group">
                    <label class="form-label">Accommodation Level</label>
                    <div class="accommodation-options">
                      <button type="button" class="accommodation-option">
                        <div class="accommodation-option__icon">🏠</div>
                        <span class="accommodation-option__label">Budget</span>
                        <span class="accommodation-option__desc">Guesthouses & Hostels</span>
                      </button>
                      <button type="button" class="accommodation-option selected">
                        <div class="accommodation-option__icon">🏨</div>
                        <span class="accommodation-option__label">Mid-Range</span>
                        <span class="accommodation-option__desc">3-4 Star Hotels</span>
                      </button>
                      <button type="button" class="accommodation-option">
                        <div class="accommodation-option__icon">🏰</div>
                        <span class="accommodation-option__label">Luxury</span>
                        <span class="accommodation-option__desc">5-Star Resorts & Villas</span>
                      </button>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="vehicle-pref">Preferred Vehicle</label>
                    <select class="form-select" id="vehicle-pref">
                      <option value="">No preference</option>
                      <option value="sedan">Sedan (2-3 persons)</option>
                      <option value="suv">SUV (4-5 persons)</option>
                      <option value="van">Mini Van (6-8 persons)</option>
                      <option value="luxury">Luxury Car</option>
                      <option value="coach">Coach Bus (20+ persons)</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="special-requirements">Special Requirements</label>
                    <textarea class="form-textarea" id="special-requirements" placeholder="Dietary needs, accessibility requirements, specific places you want to visit, budget range, or anything else we should know..."></textarea>
                  </div>

                  <div class="form-actions">
                    <button type="button" class="btn btn--ghost" data-action="prev">← Previous</button>
                    <button type="button" class="btn btn--primary" data-action="next">Review →</button>
                  </div>
                </div>

                <!-- Step 4: Review -->
                <div class="form-step" data-is-review="true">
                  <h3 class="form-step__title">Review Your Inquiry</h3>
                  <p class="form-step__subtitle">Please review your details before submitting.</p>

                  <div class="review-card">
                    <div class="review-card__title">Personal Information</div>
                    <div class="review-card__grid">
                      <div class="review-card__item">
                        <span class="review-card__label">Name</span>
                        <span class="review-card__value" id="review-name">—</span>
                      </div>
                      <div class="review-card__item">
                        <span class="review-card__label">Email</span>
                        <span class="review-card__value" id="review-email">—</span>
                      </div>
                      <div class="review-card__item">
                        <span class="review-card__label">Nationality</span>
                        <span class="review-card__value" id="review-nationality">—</span>
                      </div>
                      <div class="review-card__item">
                        <span class="review-card__label">Phone</span>
                        <span class="review-card__value" id="review-phone">—</span>
                      </div>
                    </div>
                  </div>

                  <div class="review-card">
                    <div class="review-card__title">Trip Details</div>
                    <div class="review-card__grid">
                      <div class="review-card__item">
                        <span class="review-card__label">Arrival</span>
                        <span class="review-card__value" id="review-arrival">—</span>
                      </div>
                      <div class="review-card__item">
                        <span class="review-card__label">Departure</span>
                        <span class="review-card__value" id="review-departure">—</span>
                      </div>
                      <div class="review-card__item">
                        <span class="review-card__label">Travelers</span>
                        <span class="review-card__value" id="review-travelers">—</span>
                      </div>
                      <div class="review-card__item">
                        <span class="review-card__label">Interests</span>
                        <span class="review-card__value" id="review-interests">—</span>
                      </div>
                    </div>
                  </div>

                  <div class="review-card">
                    <div class="review-card__title">Preferences</div>
                    <div class="review-card__grid">
                      <div class="review-card__item">
                        <span class="review-card__label">Accommodation</span>
                        <span class="review-card__value" id="review-accommodation">—</span>
                      </div>
                      <div class="review-card__item">
                        <span class="review-card__label">Special Notes</span>
                        <span class="review-card__value" id="review-special">—</span>
                      </div>
                    </div>
                  </div>

                  <div class="form-group checkbox-group" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
                    <input type="checkbox" id="terms-consent" required aria-required="true">
                    <label for="terms-consent">I agree to the <a href="terms.html">Terms of Service</a> and <a href="privacy.html">Privacy Policy</a>. *</label>
                  </div>
                  
                  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

                  <div class="form-actions">
                    <button type="button" class="btn btn--ghost" data-action="prev">← Edit Details</button>
                    <button type="submit" class="btn btn--accent btn--lg">✈️ Submit Inquiry</button>
                  </div>
                </div>

                <!-- Step 5: Success -->
                <div class="form-step">
                  <div style="text-align: center; padding: 2rem 1rem;">
                    <div style="color: #25D366; margin-bottom: 1rem;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    </div>
                    <h3 class="form-step__title">Inquiry Submitted!</h3>
                    <p class="form-step__subtitle" style="margin-bottom: 2rem;">Thank you for reaching out. We have received your details and will get back to you within 24 hours.</p>
                    
                    <div style="background: var(--surface); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
                      <h4 style="margin-bottom: 1rem;">Want a faster response?</h4>
                      <p style="margin-bottom: 1.5rem; color: var(--text-secondary);">You can instantly send your inquiry details directly to our WhatsApp.</p>
                      <a href="#" id="whatsapp-success-btn" target="_blank" class="btn btn--accent btn--lg" style="background: #25D366; color: white; border-color: #25D366; width: 100%;">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" style="margin-right: 8px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> Send via WhatsApp
                      </a>
                    </div>
                    <div style="margin-top: 2rem;">
                      <a href="/" class="btn btn--ghost">Return to Home</a>
                    </div>
                  </div>
                </div>

              </form>
            </div>

            <!-- Sidebar -->
            <div class="inquiry-sidebar">

              <!-- Quick Contact -->
              <div class="quick-contact-card reveal">
                <h3 class="legacy-util-17"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg> Need Help?</h3>
                <div class="quick-contact__item">
                  <div class="quick-contact__icon"><svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>
                  <div class="quick-contact__info">
                    <span class="quick-contact__label">Call Us</span>
                    <span class="quick-contact__value"><a href="tel:0729430500" style="color: inherit; text-decoration: none;">072 943 0500</a></span>
                  </div>
                </div>
                <div class="quick-contact__item">
                  <div class="quick-contact__icon"><svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></div>
                  <div class="quick-contact__info">
                    <span class="quick-contact__label">WhatsApp</span>
                    <span class="quick-contact__value"><a href="https://wa.me/940729430500?text=Hello!%20I%20would%20like%20to%20inquire%20about%20planning%20a%20trip%20with%20Tourvir." style="color: inherit; text-decoration: none;" target="_blank" rel="noopener noreferrer">072 943 0500</a></span>
                  </div>
                </div>
                <div class="quick-contact__item">
                  <div class="quick-contact__icon"><svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg></div>
                  <div class="quick-contact__info">
                    <span class="quick-contact__label">Email</span>
                    <span class="quick-contact__value"><a href="mailto:sssrajapakshe@gmail.com" style="color: inherit; text-decoration: none;">sssrajapakshe@gmail.com</a></span>
                  </div>
                </div>
                <div class="legacy-util-18">
                  <p class="legacy-util-19">Response within</p>
