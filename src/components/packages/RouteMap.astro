---
export interface Props {
  routeMap?: { name: string; coordinates: [number, number] }[];
}

const { routeMap } = Astro.props;
---

{routeMap && routeMap.length > 0 && (
  <div class="route-map-container" style="margin: var(--space-xl) 0;">
    <h3 style="margin-bottom: var(--space-sm);">Tour Route</h3>
    <p class="text-secondary" style="margin-bottom: var(--space-md);">Explore the interactive map below to see exactly where this tour takes you.</p>
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    
    <div 
      id="package-route-map" 
      data-route={JSON.stringify(routeMap)} 
      style="height: 400px; width: 100%; border-radius: var(--radius-lg); z-index: 1; border: 1px solid var(--border-color);"
    ></div>

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const mapContainer = document.getElementById('package-route-map');
        if (!mapContainer || !window.L) return;

        const routeData = JSON.parse(mapContainer.getAttribute('data-route') || '[]');
        if (routeData.length === 0) return;

        // Calculate center of the route
        const lats = routeData.map(p => p.coordinates[0]);
        const lngs = routeData.map(p => p.coordinates[1]);
        const centerLat = (Math.max(...lats) + Math.min(...lats)) / 2;
        const centerLng = (Math.max(...lngs) + Math.min(...lngs)) / 2;

        // Initialize map
        const map = L.map('package-route-map').setView([centerLat, centerLng], 7);

        // Add OpenStreetMap tiles
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // Add markers and build polyline
        const latlngs = [];
        routeData.forEach((point, index) => {
          const latlng = point.coordinates;
          latlngs.push(latlng);
          
          // Marker
          const marker = L.marker(latlng).addTo(map);
          
          // Popup
          marker.bindPopup(`<b>${point.name}</b><br>Stop ${index + 1}`);
        });

        // Add polyline connecting the points
        const polyline = L.polyline(latlngs, {
          color: '#10b981', // Tourvir primary brand color
          weight: 4,
          opacity: 0.8,
          dashArray: '10, 10',
          lineCap: 'round'
        }).addTo(map);

        // Fit map bounds to the route with padding
        map.fitBounds(polyline.getBounds(), { padding: [50, 50] });
      });
    </script>
  </div>
)}
