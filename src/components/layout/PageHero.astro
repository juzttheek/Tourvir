---
interface Props { title: string; subtitle?: string; image: string; alt: string }
const { title, subtitle, image, alt } = Astro.props;
---
<section class="page-hero"><div class="page-hero__bg"><img src={image} {alt} /></div><div class="page-hero__overlay"></div><div class="page-hero__content"><h1 class="page-hero__title">{title}</h1>{subtitle && <p class="page-hero__subtitle">{subtitle}</p>}<slot /></div></section>
