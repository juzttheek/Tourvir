---
interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  className?: string;
}

const { items, className = 'page-hero__breadcrumb' } = Astro.props;
const itemListElement = items.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.name,
  item: new URL(item.href, Astro.site).href,
}));
---

<nav class={className} aria-label="Breadcrumb">
  {
    items.map((item, index) => (
      <>
        {index > 0 && <span aria-hidden="true">→</span>}
        {index === items.length - 1 ? (
          <span data-breadcrumb-name aria-current="page">{item.name}</span>
        ) : (
          <a data-breadcrumb-name href={item.href}>{item.name}</a>
        )}
      </>
    ))
  }
</nav>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement,
  })}
/>
