---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import AnalyticsConsent from '../components/layout/AnalyticsConsent.astro';
import { canonicalPathFor } from '../../scripts/lib/seo-contract.mjs';
interface Props {
  title: string;
  description: string;
  pageStyles?: string[];
  image?: string;
  imageAlt?: string;
  socialType?: 'website' | 'article';
}

const {
  title,
  description,
  pageStyles = [],
  image = '/images/hero/hero_main_hq.webp',
  imageAlt = title,
  socialType = 'website',
} = Astro.props;

const canonicalURL = new URL(canonicalPathFor(Astro.url.pathname), Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={socialType} />
    <meta property="og:site_name" content="Tourvir" />
    <meta property="og:locale" content="en_LK" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="stylesheet" href="/css/style.css?v=5" />
    <link rel="stylesheet" href="/css/sidebar.css?v=5" />
    <link rel="stylesheet" href="/css/components.css?v=5" />
    <link rel="stylesheet" href="/css/legacy-utilities.css?v=5" />
    {pageStyles.map((href) => <link rel="stylesheet" href={`${href.startsWith('/') ? '' : '/'}${href}${href.includes('?') ? '&' : '?'}v=5`} />)}
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png?v=2" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('Tourvir-theme');
          document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="5BaBz-iCLLSpdliEoeY1aftJ2zTzFz7mTZkujwIgPRs" />

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <AnalyticsConsent />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
