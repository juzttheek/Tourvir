---
interface Props {
  title: string;
  description: string;
  pageStyles?: string[];
}

const { title, description, pageStyles = [] } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="css/style.css?v=4" />
    <link rel="stylesheet" href="css/sidebar.css?v=4" />
    <link rel="stylesheet" href="css/components.css?v=4" />
    <link rel="stylesheet" href="css/legacy-utilities.css?v=4" />
    {pageStyles.map((href) => <link rel="stylesheet" href={`${href}?v=4`} />)}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('Tourvir-theme');
          document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
