{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/blog/first-post",
      "destination": "/blog/first-post.html",
      "permanent": true
    },
    {
      "source": "/blog/kandy-temple-of-tooth",
      "destination": "/blog/kandy-temple-of-tooth.html",
      "permanent": true
    },
    {
      "source": "/blog/tea-country-ella",
      "destination": "/blog/tea-country-ella.html",
      "permanent": true
    },
    {
      "source": "/blog/yala-wildlife-safari",
      "destination": "/blog/yala-wildlife-safari.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html",
      "permanent": true
    },
    {
      "source": "/inquiry",
      "destination": "/inquiry.html",
      "permanent": true
    },
    {
      "source": "/packages",
      "destination": "/packages.html",
      "permanent": true
    },
    {
      "source": "/packages/package-1-cultural-triangle-explorer",
      "destination": "/packages/package-1-cultural-triangle-explorer.html",
      "permanent": true
    },
    {
      "source": "/packages/package-2-beach-paradise-retreat",
      "destination": "/packages/package-2-beach-paradise-retreat.html",
      "permanent": true
    },
    {
      "source": "/packages/package-3-wildlife-safari-adventure",
      "destination": "/packages/package-3-wildlife-safari-adventure.html",
      "permanent": true
    },
    {
      "source": "/packages/package-4-hill-country-adventure",
      "destination": "/packages/package-4-hill-country-adventure.html",
      "permanent": true
    },
    {
      "source": "/packages/package-5-honeymoon-special",
      "destination": "/packages/package-5-honeymoon-special.html",
      "permanent": true
    },
    {
      "source": "/packages/package-6-ancient-cities-heritage",
      "destination": "/packages/package-6-ancient-cities-heritage.html",
      "permanent": true
    },
    {
      "source": "/packages/package-7-complete-sri-lanka-experience",
      "destination": "/packages/package-7-complete-sri-lanka-experience.html",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/vehicles",
      "destination": "/vehicles.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://va.vercel-scripts.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://avatars.githubusercontent.com https://*.tile.openstreetmap.org https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://formspree.io https://api.github.com https://unpkg.com https://vitals.vercel-insights.com https://api.open-meteo.com https://open.er-api.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; frame-src 'self' https://maps.google.com https://www.google.com; frame-ancestors 'none';"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
